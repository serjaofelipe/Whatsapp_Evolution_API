# ============================================
# CONFIGURAÇÃO DO WHATSAJAX (exemplo)
# Copie este arquivo para .env e preencha os valores.
# ============================================

# Evolution API
EVOLUTION_API_URL=http://localhost:8080
AUTHENTICATION_API_KEY=SUA_CHAVE_API_EVOLUTION
INSTANCE_NAME=Atlas

# Administradores (números separados por vírgula, ex: 5541999999999)
ADMIN_MASTER_NUMBERS=
ADMIN_NUMBERS=

# Porta do servidor
SERVER_PORT=8000
