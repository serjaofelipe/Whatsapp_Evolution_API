# ============================================
# CONFIGURAÇÃO DO WHATSAJAX (exemplo)
# Copie este arquivo para .env e preencha os valores.
# ============================================

# Evolution API
EVOLUTION_API_URL=http://localhost:8080
AUTHENTICATION_API_KEY=SUA_CHAVE_API_EVOLUTION
INSTANCE_NAME=Atlas

# Administradores (números separados por vírgula, ex: 5541999999999)
ADMIN_MASTER_NUMBERS=
ADMIN_NUMBERS=

# Porta do servidor
SERVER_PORT=8000

# Idade máxima (segundos) para processar uma mensagem recebida.
# Mensagens mais antigas que isso são descartadas na hora (sem log/processo).
# 1800 = 30 minutos. Aumente/diminua conforme sua necessidade.
MESSAGE_MAX_AGE_SECONDS=1800
